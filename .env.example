# Template. Copy to .env and fill in with real values.
#
# .env is gitignored; THIS file is committed — never put a real password or
# secret in here.
#
# Keys are read top to bottom and the LAST one wins, so define each key exactly
# once. Commenting out an old line is safe; leaving two live copies is not —
# an empty NEXTAUTH_SECRET further down silently overrides a good one above it.
#
# Three environments, three sets of values. Uncomment the block you need:
#
#                    the app runs at                 calendar is displayed on
#   local        http://localhost:3000               (n/a)
#   test         https://agliit.webcodes.ee          https://fbtest.webcodes.ee
#   production   https://agliit.agilityliit.ee       https://agilityliit.ee
#
# The proxy port (e.g. 3939) never appears here — it lives only in the hosting
# panel's proxy rule and in the PM2 start command.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://username:password@localhost:3306/DB_NAME"

# ── Auth ────────────────────────────────────────────────────────────────────
# One per environment, never reused: openssl rand -base64 32
# Changing it logs everyone out.
NEXTAUTH_SECRET=""

# ── Where this app lives ────────────────────────────────────────────────────
# This app's own public address, as the browser sees it. No port, no trailing
# slash, and never the WordPress domain.
#
# NEXTAUTH_URL is used for sign-in redirects — wrong value and login appears to
# succeed but bounces back to the login page.
# PUBLIC_APP_URL builds the links in the calendar feed and in reset mails. It
# defaults to NEXTAUTH_URL, so it can be left out entirely.

# --- local ---
# NEXTAUTH_URL="http://localhost:3000"
# PUBLIC_APP_URL="http://localhost:3000"

# --- test ---
NEXTAUTH_URL="https://agliit.webcodes.ee"
PUBLIC_APP_URL="https://agliit.webcodes.ee"

# --- production ---
# NEXTAUTH_URL="https://agliit.agilityliit.ee"
# PUBLIC_APP_URL="https://agliit.agilityliit.ee"

# ── Who may read the public API ─────────────────────────────────────────────
# Which WEBSITES may fetch /api/public/* from a browser: the WordPress site
# that displays the calendar — never this app's own address. Comma-separated,
# no trailing slashes.
#
# Same server does not mean same origin — a different hostname is cross-origin
# and needs to be listed. Listing several is fine, and is the easy way through
# a cutover: keep the test site allowed while production starts.
#
# When unset, defaults to https://agilityliit.ee and https://www.agilityliit.ee

# --- test ---
PUBLIC_ALLOWED_ORIGINS="https://fbtest.webcodes.ee"

# --- production (include www: it counts as a separate origin) ---
# PUBLIC_ALLOWED_ORIGINS="https://agilityliit.ee,https://www.agilityliit.ee"

# ── Outgoing mail ───────────────────────────────────────────────────────────
# Required in production: without it, password reset has no way to reach anyone.
# Use the same account the WordPress site sends from, so the domain's SPF/DKIM
# still apply. With SMTP unset in development, reset mails are logged to the
# console instead of being sent.
SMTP_HOST="smtp.example.ee"
SMTP_PORT="587"
SMTP_USER="no-reply@agilityliit.ee"
SMTP_PASSWORD=""
SMTP_FROM="Eesti Agility Liit <no-reply@agilityliit.ee>"
