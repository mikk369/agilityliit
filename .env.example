# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/agliit"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The app's own origin. http://localhost:3000 in development.
NEXTAUTH_URL="https://agliit.agilityliit.ee"

# ── Public API and links ────────────────────────────────────────────────────
# Base URL used in the WordPress calendar feed and in password reset mails.
# Defaults to NEXTAUTH_URL when unset.
PUBLIC_APP_URL="https://agliit.agilityliit.ee"
# Who may read /api/public/* from a browser. Comma-separated.
# Defaults to agilityliit.ee and www.agilityliit.ee.
PUBLIC_ALLOWED_ORIGINS="https://agilityliit.ee"

# ── Outgoing mail ───────────────────────────────────────────────────────────
# Required in production: without it password reset cannot send.
# Use the same account the WordPress site sends from, so SPF/DKIM still apply.
SMTP_HOST="smtp.example.ee"
SMTP_PORT="587"
SMTP_USER="no-reply@agilityliit.ee"
SMTP_PASSWORD=""
SMTP_FROM="Eesti Agility Liit <no-reply@agilityliit.ee>"
